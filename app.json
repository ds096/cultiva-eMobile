{
  "expo": {
    "name": "cultiva-e",
    "slug": "cultiva-e",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.daniels096.MeuProjeto"
    },
    "web": {},
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/withCmakeVersion",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_plus_name.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAF7"
        }
      ]
    ]
  }
}
